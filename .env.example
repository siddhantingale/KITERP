# ─────────────────────────────────────────────────────────────
#  EduTrack configuration — copy this file to ".env" and edit.
#  Everything is optional; the app runs with no .env at all.
# ─────────────────────────────────────────────────────────────

# Port the server listens on (the API, and the built app with "npm start")
PORT=3001

# Where the database and uploaded files are stored (relative to the project folder)
# DATA_DIR=data

# Secret used to sign login sessions. Leave empty to auto-generate one
# (saved in data/.jwt-secret). Set it explicitly in production.
# JWT_SECRET=change-me-to-a-long-random-string

# Optional: create this admin account on first start.
# (Otherwise the FIRST account that signs up becomes the admin.)
# ADMIN_LOGIN_EMAIL=admin@yourcollege.edu
# ADMIN_LOGIN_PASSWORD=change-me

# Set to false to stop public sign-ups (admin creates accounts instead).
ALLOW_SIGNUP=true

# Public address of the app, used to build links to uploaded files.
# Only needed behind a reverse proxy / custom domain.
# PUBLIC_URL=https://edutrack.yourcollege.edu

# ── Email (alerts, reports, announcements) ──────────────────
# Gmail: use an App Password (Google Account → Security → App passwords)
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your-16-char-app-password
# Recipient of admin reports:
# ADMIN_EMAIL=you@gmail.com
#
# Or any SMTP server instead of Gmail:
# SMTP_HOST=smtp.yourhost.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# EMAIL_FROM=noreply@yourcollege.edu

# ── AI features (OCR attendance import, AI timetable, AI reports) ──
# Pick ONE provider. "openai" also works with any OpenAI-compatible API
# (Groq, OpenRouter, Google Gemini's OpenAI endpoint, local Ollama, ...).
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
#
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ── Maps ─────────────────────────────────────────────────────
# Mapbox token for the 3D live-tracking map (2D map works without it).
# Needs a rebuild/restart of the frontend after changing.
# VITE_MAPBOX_ACCESS_TOKEN=pk.your_token

# Max upload size in MB
# MAX_UPLOAD_MB=25
